<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(FrameWorkAllSupported)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>SimpleDB.SqlServer - SQL Server provider for SimpleDB. Enables SQL Server as a storage backend with automatic schema generation and migrations.</Description>
    <Title>SimpleDB SQL Server Provider</Title>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\SimpleDB.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SimpleDB.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
